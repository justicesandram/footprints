{
  "name": "tnmdev/footprints",
  "description": "Request and response footprints",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "TNM\\Footprints\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Saul Chelewani",
      "email": "saulchelewani@gmail.com"
    },
    {
      "name": "Justice Sandram",
      "email": "justicesandram@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0",
    "illuminate/queue": "^9.0|^10.0|^11.0",
    "ext-rdkafka": "*",
    "illuminate/routing": "^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^9.0|^10.0",
    "mockery/mockery": "^1.0"
  },
  "autoload-dev": {
